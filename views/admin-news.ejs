<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Новости — админка</title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/admin/assets/admin.css" />
  </head>
  <body>
    <div class="bg-gradient"></div>
    <div class="admin-wrap">
      <div class="admin-top">
        <div class="brand"><div class="brand-badge">ТО</div><div><h1>Новости</h1><p>Публикация на news.html</p></div></div>
        <div class="top-actions">
          <a class="btn btn-outline" href="/admin/home">← Кабинет</a>
          <form method="post" action="/admin/logout" style="margin:0"><button class="btn btn-dark" type="submit">Выйти</button></form>
        </div>
      </div>
      <%- include('partials/admin-nav', { admin, active: 'news' }) %>

      <div class="card" style="margin-bottom:14px;padding:18px">
        <h3 style="margin:0 0 12px">Добавить новость</h3>
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <form method="post" action="/admin/news" class="form-grid">
          <input name="title" placeholder="Заголовок" required />
          <select name="category">
            <option>Новости</option>
            <option>Проекты</option>
            <option>Достижения</option>
            <option>Анонс</option>
          </select>
          <textarea name="body" rows="4" placeholder="Текст новости" required style="grid-column:1/-1"></textarea>
          <label class="check"><input type="checkbox" name="published" value="1" checked /> Опубликовать сразу на сайте</label>
          <button class="btn btn-primary" type="submit">Сохранить</button>
        </form>
      </div>

      <div class="card">
        <table>
          <thead><tr><th>Дата</th><th>Заголовок</th><th>Категория</th><th>Статус</th><th></th></tr></thead>
          <tbody>
            <% items.forEach((n) => { %>
            <tr>
              <td class="muted"><%= new Date(n.created_at).toLocaleString('ru-RU') %></td>
              <td><strong><%= n.title %></strong><div class="muted" style="max-width:360px"><%= n.body.slice(0,120) %>…</div></td>
              <td><%= n.category || '—' %></td>
              <td><%= n.published ? 'На сайте' : 'Черновик' %></td>
              <td>
                <form method="post" action="/admin/news/<%= n.id %>/toggle">
                  <button class="btn btn-outline" type="submit"><%= n.published ? 'Снять' : 'Опубликовать' %></button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </body>
</html>
