<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Сеансы — админка</title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/admin/assets/admin.css" />
  </head>
  <body>
    <div class="bg-gradient"></div>
    <div class="admin-wrap">
      <div class="admin-top">
        <div class="brand"><div class="brand-badge">ТО</div><div><h1>Расписание сеансов</h1><p>Отображается на seansy.html для родителей</p></div></div>
        <div class="top-actions">
          <a class="btn btn-outline" href="/admin/home">← Кабинет</a>
          <a class="btn btn-outline" href="/seansy.html" target="_blank">Страница на сайте</a>
          <form method="post" action="/admin/logout" style="margin:0"><button class="btn btn-dark" type="submit">Выйти</button></form>
        </div>
      </div>
      <%- include('partials/admin-nav', { admin, active: 'sessions' }) %>

      <% if (admin.role === 'admin' || admin.role === 'coordinator') { %>
      <div class="card" style="margin-bottom:14px;padding:18px">
        <h3 style="margin:0 0 12px">Добавить сеанс</h3>
        <% if (error === 'fill') { %><div class="error">Укажите название и дату</div><% } %>
        <form method="post" action="/admin/sessions" class="form-grid">
          <input name="title" placeholder="Название сеанса" required />
          <input name="session_date" type="date" required />
          <input name="session_time" type="time" placeholder="Время" />
          <input name="direction" placeholder="Направление (логопед, психолог…)" />
          <select name="specialist_id">
            <option value="">— Специалист —</option>
            <% specialists.forEach((s) => { %>
            <option value="<%= s.id %>"><%= s.full_name || s.username %></option>
            <% }) %>
          </select>
          <input name="duration_min" type="number" placeholder="Минут" value="45" min="15" max="180" />
          <input name="max_slots" type="number" placeholder="Мест" value="1" min="1" max="20" />
          <input name="place" placeholder="Место" value="Кабинет «Точка Открытий»" style="grid-column:1/-1" />
          <textarea name="description" rows="2" placeholder="Описание для родителей" style="grid-column:1/-1"></textarea>
          <textarea name="tips_for_parents" rows="2" placeholder="Памятка: что взять с собой, как подготовиться" style="grid-column:1/-1"></textarea>
          <label class="check"><input type="checkbox" name="published" value="1" checked /> Показывать на сайте</label>
          <button class="btn btn-primary" type="submit">Создать сеанс</button>
        </form>
      </div>
      <% } %>

      <div class="card">
        <table>
          <thead>
            <tr>
              <th>Дата</th>
              <th>Сеанс</th>
              <th class="hide-mobile">Специалист</th>
              <th>Статус</th>
              <th>На сайте</th>
              <th style="width:200px">Действия</th>
            </tr>
          </thead>
          <tbody>
            <% if (!items.length) { %>
            <tr><td colspan="6" class="empty">Сеансов пока нет</td></tr>
            <% } %>
            <% items.forEach((s) => { %>
            <tr>
              <td>
                <strong><%= s.session_date %></strong>
                <div class="muted"><%= s.session_time || '—' %> · <%= s.duration_min %> мин</div>
              </td>
              <td>
                <strong><%= s.title %></strong>
                <div class="muted"><%= s.direction || '' %></div>
                <% if (s.tips_for_parents) { %><div class="muted tip-preview"><%= s.tips_for_parents.slice(0,80) %>…</div><% } %>
              </td>
              <td class="hide-mobile muted"><%= s.specialist_name || '—' %></td>
              <td>
                <span class="status-pill status-<%= s.status %>"><%= s.status === 'scheduled' ? 'Запланирован' : (s.status === 'completed' ? 'Завершён' : 'Отменён') %></span>
              </td>
              <td><%= s.published ? 'Да' : 'Нет' %></td>
              <td>
                <div class="action-stack">
                  <% if (s.status === 'scheduled') { %>
                  <form method="post" action="/admin/sessions/<%= s.id %>/status">
                    <input type="hidden" name="status" value="completed" />
                    <button class="btn btn-primary btn-sm" type="submit">Завершить</button>
                  </form>
                  <% if (admin.role !== 'specialist') { %>
                  <form method="post" action="/admin/sessions/<%= s.id %>/status">
                    <input type="hidden" name="status" value="cancelled" />
                    <button class="btn btn-outline btn-sm" type="submit">Отменить</button>
                  </form>
                  <% } %>
                  <% } %>
                  <% if (admin.role === 'admin' || admin.role === 'coordinator') { %>
                  <form method="post" action="/admin/sessions/<%= s.id %>/toggle">
                    <button class="btn btn-outline btn-sm" type="submit"><%= s.published ? 'Скрыть' : 'На сайт' %></button>
                  </form>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </body>
</html>
